# syntax=docker/dockerfile:1
# Autoware Universe - NVIDIA Jetson Orin
# Target: L4T R36.3.0 / JetPack 6.0 / CUDA 12.2 / Ubuntu 22.04 / ROS 2 Humble

ARG BASE_IMAGE=dustynv/ros:humble-ros-base-l4t-r36.3.0

# ──────────────────────────────────────────────────────────
# Stage 1: dependency layer
# ──────────────────────────────────────────────────────────
FROM ${BASE_IMAGE} AS autoware-orin-deps

ARG ROS_DISTRO=humble
ARG USERNAME=aw
ARG USER_UID=1000
ARG USER_GID=1000

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Create a non-root user with sudo
RUN if ! getent group ${USER_GID} >/dev/null 2>&1; then \
      groupadd --gid ${USER_GID} ${USERNAME}; \
    fi && \
    if ! id -u ${USERNAME} >/dev/null 2>&1; then \
      useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME}; \
    fi && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && \
    chmod 0440 /etc/sudoers.d/${USERNAME}

# System packages
RUN --mount=type=cache,id=apt-cache-orin,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-orin,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      # Build essentials
      build-essential \
      cmake \
      ccache \
      ninja-build \
      git \
      wget \
      curl \
      unzip \
      # Python
      python3-pip \
      python3-dev \
      python3-setuptools \
      python3-vcstool \
      python3-colcon-common-extensions \
      python3-colcon-mixin \
      python3-rosdep \
      pipx \
      # Visualization (rviz2, rqt)
      ros-${ROS_DISTRO}-rviz2 \
      ros-${ROS_DISTRO}-rqt \
      ros-${ROS_DISTRO}-rqt-common-plugins \
      ros-${ROS_DISTRO}-foxglove-bridge \
      # ROS core packages
      ros-${ROS_DISTRO}-pcl-ros \
      ros-${ROS_DISTRO}-tf2-eigen \
      ros-${ROS_DISTRO}-tf2-geometry-msgs \
      ros-${ROS_DISTRO}-tf2-sensor-msgs \
      ros-${ROS_DISTRO}-sensor-msgs \
      ros-${ROS_DISTRO}-geometry-msgs \
      ros-${ROS_DISTRO}-nav-msgs \
      ros-${ROS_DISTRO}-visualization-msgs \
      ros-${ROS_DISTRO}-diagnostic-msgs \
      ros-${ROS_DISTRO}-image-transport \
      ros-${ROS_DISTRO}-cv-bridge \
      ros-${ROS_DISTRO}-topic-tools \
      ros-${ROS_DISTRO}-rosbag2 \
      ros-${ROS_DISTRO}-rosbag2-storage-mcap \
      ros-${ROS_DISTRO}-rosbridge-server \
      ros-${ROS_DISTRO}-ros2bag \
      # C++ libraries used by Autoware
      libboost-all-dev \
      libeigen3-dev \
      libpcl-dev \
      libopencv-dev \
      libyaml-cpp-dev \
      libgoogle-glog-dev \
      libgflags-dev \
      nlohmann-json3-dev \
      libtinyxml2-dev \
      libgeographic-dev \
      # Utilities
      tmux \
      vim \
      nano \
      htop \
      net-tools \
      can-utils \
    && rm -rf /var/lib/apt/lists/*

# rosdep
RUN rosdep init 2>/dev/null || true && rosdep update

# colcon mixin (optional, speeds up incremental builds)
RUN colcon mixin add default \
      https://raw.githubusercontent.com/colcon/colcon-mixin-repository/master/index.yaml \
      2>/dev/null || true && \
    colcon mixin update default 2>/dev/null || true

# ──────────────────────────────────────────────────────────
# Environment variables (Orin-specific)
# ──────────────────────────────────────────────────────────
# Orin = Ampere sm_87
ENV CMAKE_CUDA_ARCHITECTURES="87"
ENV CUDA_ARCH_BIN="8.7"

# ccache settings
ENV CC="/usr/lib/ccache/gcc"
ENV CXX="/usr/lib/ccache/g++"
ENV CCACHE_DIR="/home/${USERNAME}/.ccache"
ENV CCACHE_MAXSIZE="10G"

# X11 / display
ENV DISPLAY=:0
ENV QT_X11_NO_MITSHM=1
ENV LIBGL_ALWAYS_SOFTWARE=0

# Suppress colcon desktop-notification errors
ENV COLCON_EXTENSION_BLOCKLIST="colcon_core.event_handler.desktop_notification"

# Shell auto-source for root
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc && \
    echo "[ -f /autoware/install/setup.bash ] && source /autoware/install/setup.bash" >> /etc/bash.bashrc

# Shell auto-source for user
USER ${USERNAME}
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "[ -f /autoware/install/setup.bash ] && source /autoware/install/setup.bash" >> ~/.bashrc && \
    echo "export CMAKE_CUDA_ARCHITECTURES=87" >> ~/.bashrc && \
    echo "export HISTFILESIZE=10000" >> ~/.bashrc

WORKDIR /autoware

# ──────────────────────────────────────────────────────────
# Stage 2: add build artifacts (optional, for pre-built image)
# Use this stage only if you want to bake a pre-built image.
# For source-mount dev workflow, use stage 1 directly.
# ──────────────────────────────────────────────────────────
FROM autoware-orin-deps AS autoware-orin-built

ARG ROS_DISTRO=humble
ARG USERNAME=aw

USER root

# Copy and build Autoware if source is available at build time
# In the typical dev workflow this stage is skipped —
# source lives on the host and is mounted at runtime.
COPY --chown=${USERNAME}:${USERNAME} . /autoware/

RUN if [ -f /autoware/autoware.repos ]; then \
      su ${USERNAME} -c " \
        cd /autoware && \
        vcs import src < autoware.repos && \
        source /opt/ros/${ROS_DISTRO}/setup.bash && \
        rosdep install -y --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} && \
        colcon build \
          --symlink-install \
          --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES=87 \
      "; \
    else \
      echo '[INFO] No autoware.repos found — skipping build. Mount source at runtime.'; \
    fi

WORKDIR /autoware
USER ${USERNAME}
